{
  "name": "mvc-gateway",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:deck-source-of-truth && next build",
    "start": "next start",
    "lint": "eslint",
    "check:rebrand-preservation": "node scripts/check-rebrand-preservation.mjs",
    "check:deck-source-of-truth": "node scripts/check-deck-source-of-truth.mjs",
    "check:rewrite-ordering": "node scripts/check-rewrite-ordering.mjs",
    "validate:fast": "npm run check:rebrand-preservation && npm run check:deck-source-of-truth && npm run check:rewrite-ordering && npm run lint",
    "validate:release": "npm run check:rebrand-preservation && npm run check:deck-source-of-truth && npm run check:rewrite-ordering && npm run lint && npm run build"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.50.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.574.0",
    "next": "^15.5.25",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.12",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
}
